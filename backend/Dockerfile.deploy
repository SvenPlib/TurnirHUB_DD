FROM node:22-bookworm-slim
# OpenSSL potreben za Prisma Client
RUN apt-get update && \
    apt-get install -y --no-install-recommends openssl && \
    rm -rf /var/lib/apt/lists/*
WORKDIR /app
ENV NODE_ENV=production
# Kopiramo pripravljene datoteke iz build artefakta
COPY . .
EXPOSE 3000
CMD ["node", "server.js"]
